 height:7px; border:1px solid var(--text-secondary); border-radius:50%; }\n.repair-part[aria-pressed=true] .repair-part-ring { background:var(--text-secondary); }\n.repair-panel { display:flex; flex-direction:column; gap:12px; }\n.repair-dialogue { background:var(--surface-raised); border:1px solid var(--hairline); border-radius:var(--radius-panel); padding:8px 16px 12px; min-height:145px; }\n.repair-speaker { display:flex; align-items:center; justify-content:space-between; color:var(--text-secondary); font-size:14px; }\n.repair-speaker button { width:44px; height:44px; display:grid; place-items:center; border-radius:var(--radius-tile); }\n.repair-speaker svg { width:22px; height:22px; fill:none; stroke:currentColor; stroke-width:1.5; }\n.repair-line { font-family:var(--font-serif); font-size:28px; line-height:1.5; min-height:44px; }\n.repair-line .word { font-size:inherit; line-height:1.5; padding:0 2px; min-width:44px; min-height:44px; }\n.repairs .word { vertical-align:baseline; }\n.repair-operations { padding:0 4px; }\n.repair-part-name { display:flex; align-items:center; gap:5px; min-height:44px; color:var(--text-secondary); }\n.repair-part-name .word, .repair-gift-words .word { min-height:44px; font-size:18px; }\n.repair-part-actions { display:flex; gap:8px; min-height:48px; margin:4px 0 12px; }\n.repair-action { border:1px solid var(--hairline-strong); border-radius:var(--radius-tile); background:var(--surface-control); min-height:46px; padding:8px 12px; min-width:64px; }\n.repair-part-actions .repair-action { flex:1; background:var(--surface-card); }\n.repair-main-actions { display:flex; gap:6px; flex-wrap:wrap; padding-top:12px; border-top:1px solid var(--hairline-strong); }\n.repair-main-actions .repair-action:first-child { background:var(--surface-sunk); }\n.repair-main-actions .repair-action:last-child { margin-left:auto; background:transparent; color:var(--text-secondary); }\n.repair-shelf { min-height:175px; }\n.repair-gift-words { display:flex; margin-top:12px; }\n.repairs button:focus-visible { outline:3px solid var(--text-primary); outline-offset:3px; }\n@media(max-width:760px) {\n  .repairs { padding:8px; }\n  .repair-header { margin-bottom:8px; }\n  .repair-header h2 .word { font-size:18px; }\n  .repair-jobs > button { min-width:78px; padding:6px 10px; }\n  .repair-layout { grid-template-columns:minmax(0,1fr); gap:8px; }\n  .repair-panel { gap:4px; }\n  .repair-dialogue { padding:2px 12px 8px; min-height:108px; }\n  .repair-line { font-size:28px; }\n  .repair-speaker { height:38px; }\n  .repair-speaker button { height:44px; }\n  .repair-part-name { min-height:44px; }\n  .repair-part-actions { margin:0 0 8px; min-height:0; }\n  .repair-part-actions:empty { display:none; }\n  .repair-main-actions { padding-top:8px; }\n  .repair-action { padding:6px 9px; min-width:62px; font-size:15px; }\n}\n@media(prefers-reduced-motion:reduce) {\n  .repairs *, .repairs *::before, .repairs *::after { animation:none !important; transition:none !important; }\n}\n\n.repair-leaders { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; overflow:visible; }\n.repair-leaders line { stroke:var(--surface-card); stroke-width:.65; paint-order:stroke; }\n.repair-leaders ellipse { fill:none; stroke:var(--surface-card); stroke-width:.35; stroke-dasharray:1 1; }\n.repair-leaders [data-selected=true] ellipse { stroke:var(--text-primary); stroke-width:.6; stroke-dasharray:none; }\n"],["STYLE",{},".garden {max-width: 1000px; margin: 0 auto; color: var(--text-primary); font-family: var(--font-sans); padding: var(--space-16);}\n.garden button {font: inherit; color: inherit; touch-action: manipulation; user-select: none;}\n.garden button:focus-visible {outline: 3px solid var(--text-secondary); outline-offset: 4px;}\n.garden .word {min-width: 44px; min-height: 44px; padding: 4px 3px; font-size: inherit; line-height: 1.5;}\n.garden-heading {display: flex; justify-content: space-between; align-items: center; gap: 12px;}\n.garden-heading h1 {margin: 0; font-family: var(--font-serif); font-size: 24px; font-weight: 500;}\n.garden-weather {font-size: 16px; border-bottom: 1px solid var(--hairline-strong);}\n.garden-scene {position: relative; width: 100%; aspect-ratio: 360 / 280; overflow: hidden; border-radius: var(--radius-panel); background: var(--surface-sunk); margin: 8px 0 0;}\n.garden-scene canvas {display: block; width: 100%; height: 100%; image-rendering: pixelated;}\n.garden-site {position: absolute; transform: translate(-50%, -25%); width: 52px; height: 44px; border: 1px dashed var(--text-muted); border-radius: 50%; background: transparent; cursor: pointer;}\n.garden-site.occupied {border-color: transparent;}\n.garden-site.selected {border: 2px solid var(--text-secondary); background: #fbf7ef30;}\n.garden-site:hover {border-color: var(--text-primary);}\n.garden-pots {display: grid; grid-template-columns: repeat(3, 1fr); max-width: 520px; margin: -20px auto 12px; position: relative; gap: 8px;}\n.garden-pot-card {display: flex; align-items: center; justify-content: center; flex-wrap: wrap; background: var(--surface-card); border: 1px solid var(--hairline-strong); border-radius: var(--radius-chip); padding: 4px 8px; box-shadow: var(--shadow-chip);}\n.garden-pot-card.active {border-color: var(--text-secondary); box-shadow: inset 0 -3px var(--text-secondary);}\n.garden-pot-select {display: flex; gap: 6px; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; background: transparent; border: 0; cursor: pointer;}\n.garden-pot-name {font-family: var(--font-serif); font-size: 20px;}\n.garden-stages {display: flex; gap: 3px;}\n.garden-stages i {display: block; width: 5px; height: 13px; background: var(--surface-sunk); border: 1px solid var(--hairline-strong);}\n.garden-stages i[data-grown=true] {background: var(--text-secondary);}\n.garden-sprig {display: block; width: 18px; height: 30px; position: relative; border-bottom: 9px solid var(--text-muted);}\n.garden-sprig::before {content: ''; position: absolute; width: 2px; height: 20px; background: var(--text-secondary); left: 8px;}\n.garden-sprig i {position: absolute; width: 8px; height: 5px; background: var(--jade); left: 1px; top: 4px; transform: rotate(25deg);}\n.garden-sprig i:nth-child(2) {left: 9px; top: 9px; transform: rotate(-25deg);}\n.garden-sprig i:nth-child(3) {top: 15px;}\n.garden-workbench {display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--hairline-strong);}\n.garden-selection {display: flex; align-items: center; gap: 8px; flex-wrap: wrap;}\n.garden-selection strong {font-family: var(--font-serif); font-size: 24px; font-weight: 500;}\n.garden-selection > span {font-size: 16px; color: var(--text-secondary);}\n.garden-tools {display: flex; gap: 12px; flex-wrap: wrap;}\n.garden-tool {display: flex; align-items: center; gap: 2px;}\n.garden-tool-button,.garden-replay {display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; border: 1px solid var(--hairline-strong); border-radius: var(--radius-chip); background: var(--surface-control); cursor: pointer;}\n.garden-tool-button[aria-pressed=true] {background: var(--surface-sunk); outline: 2px solid var(--text-secondary);}\n.garden-tool-button:disabled {opacity: .4; cursor: default;}\n.garden-tool-label {font-size: 16px;}\n.garden-conversation {padding: 20px 24px; background: var(--surface-card); border-radius: var(--radius-panel); margin-top: 16px; box-shadow: var(--shadow-chip);}\n.garden-speaker {display: flex; align-items: center; justify-content: space-between; color: var(--text-secondary); font-size: 16px;}\n.garden-spoken {font-family: var(--font-serif); font-size: 30px; line-height: 1.6; margin: 8px 0 0;}\n.garden-final-token {display: inline-flex; align-items: baseline; white-space: nowrap;}\n.garden-replay {background: transparent; border-color: transparent;}\n.garden-footer {display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4px 16px; color: var(--text-secondary); font-size: 14px; padding: 8px;}\n.garden-footer p {margin: 0;}\n.garden-footer .garden-tool {margin-left: auto;}\n.garden-comparison {display: flex; align-items: center; gap: 8px; color: var(--text-secondary); font-size: 14px;}\n.garden-comparison > span {display: inline-flex; align-items: center; gap: 4px;}\n.garden-comparison i {display: block; height: 16px; width: 18px; background: linear-gradient(to right, var(--text-secondary) 0 25%, transparent 25% 37%, var(--text-secondary) 37% 62%, transparent 62% 74%, var(--text-secondary) 74%); opacity: .35;}\n.garden-comparison i[data-growth='0'] {background: var(--surface-sunk);}\n.garden-comparison i[data-growth='1'] {clip-path: inset(0 70% 0 0); opacity: 1;}\n.garden-comparison i[data-growth='2'] {clip-path: inset(0 35% 0 0); opacity: 1;}\n.garden-comparison i[data-growth='3'] {opacity: 1;}\n.garden-arrival {display: flex; align-items: center; justify-content: center; gap: 16px; padding: 24px; font-size: 20px;}\n.garden-arrival p {margin: 0;}\n.garden-confirm {color: var(--text-primary); background: var(--surface-card); border: 1px solid var(--hairline-strong); border-radius: var(--radius-panel); max-width: min(540px, calc(100vw - 40px)); padding: 24px; box-shadow: var(--shadow-panel);}\n.garden-confirm-backdrop {position: fixed; inset: 0; z-index: 15; display: flex; align-items: center; justify-content: center; padding: 20px; background: #241d1680;}\n.garden-confirm {max-height: calc(100dvh - 40px); overflow: auto; box-sizing: border-box;}\n.garden-confirm h2 {font-family: var(--font-serif); font-size: 28px; font-weight: 500; margin: 0;}\n.garden-confirm p {color: var(--text-secondary); font-size: 20px;}\n.garden-confirm-actions {display: flex; justify-content: flex-end; gap: 12px; padding-top: 12px;}\n.garden-confirm-actions > button {min-height: 48px; min-width: 88px; padding: 8px 16px; border: 1px solid var(--hairline-strong); border-radius: var(--radius-chip); background: var(--surface-control); cursor: pointer;}\n@media (min-width: 760px) {.garden-scene {max-width: 720px; margin-left: auto; margin-right: auto;} }\n@media (max-width: 600px) {.garden {padding: 8px;} .garden-heading h1 {font-size: 20px;} .garden-pots {margin-top: -8px;} .garden-pot-card {padding: 2px;} .garden-pot-name {font-size: 18px;} .garden-workbench {padding: 8px 4px;} .garden-tools {gap: 8px;} .garden-tool {gap: 0;} .garden-tool-label {font-size: 14px;} .garden-conversation {padding: 12px 16px;} .garden-spoken {font-size: 28px;} .garden-footer {padding: 4px;} .garden-footer .word {font-size: 14px;} }\n@media (prefers-reduced-motion: reduce) {.garden *, .garden *::before, .garden *::after {transition: none !important; animation: none !important;} }\n"],["STYLE",{},".neighbourhood-nav { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; padding: 8px; border: 1px solid var(--hairline); border-radius: var(--radius-chip); background: var(--surface-card); }\n.neighbourhood-nav button { flex: 1 1 auto; min-width: 64px; min-height: 44px; padding: 8px 12px; border: 1px solid transparent; border-radius: var(--radius-tile); background: transparent; color: var(--text-secondary); }\n.neighbourhood-nav button[aria-current=\"page\"] { border-color: var(--hairline-strong); background: var(--surface-raised); color: var(--text-primary); }\n.neighbourhood-feature { outline: none; }\n.neighbourhood-feature:focus-visible { outline: 2px solid var(--text-primary); outline-offset: 4px; }\n.neighbourhood-gifts { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 16px 0; padding: 12px; border: 1px solid var(--hairline); border-radius: var(--radius-panel); background: var(--surface-card); }\n.neighbourhood-gifts button { min-height: 44px; padding: 8px 16px; border: 1px solid var(--hairline-strong); border-radius: var(--radius-tile); background: var(--surface-control); }\n.neighbourhood-gift-note { width: fit-content; max-width: 100%; margin: 16px auto; padding: 12px 16px; border: 1px solid var(--hairline); border-radius: var(--radius-panel); background: var(--surface-card); box-shadow: var(--shadow-panel); }\n.neighbourhood-gift-note .help-line { display: flex; align-items: center; gap: 16px; }\n.neighbourhood-gift-note .spoken { margin: 0; font-size: 28px; }\n.neighbourhood-gift-note .round-button { flex-shrink: 0; }\n@media (max-width: 600px) { .neighbourhood-nav { gap: 4px; padding: 4px; } .neighbourhood-nav button { min-width: 56px; padding: 8px; font-size: 14px; } }\n"],["STYLE",{},".restaurant-scene {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 9 / 7;\n  isolation: isolate;\n  overflow: hidden;\n  background: var(--surface-sunk, #e8dfcf);\n  border-radius: var(--radius-panel, 16px);\n  box-shadow: inset 0 0 0 1px var(--hairline, #241d161a);\n}\n.restaurant-scene canvas {\n  display: block;\n  width: 100%;\n  height: 100%;\n  image-rendering: pixelated;\n  cursor: pointer;\n  touch-action: manipulation;\n}\n.restaurant-scene .scene-target {\n  position: absolute;\n  transform: translate(-50%, -50%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  min-width: 44px;\n  min-height: 44px;\n  padding: 4px 7px;\n  border: 0;\n  border-radius: var(--radius-tile, 8px);\n  background: transparent;\n  color: var(--text-primary, #241d16);\n  font: 500 14px/20px var(--font-sans, sans-serif);\n  cursor: pointer;\n  touch-action: manipulation;\n  -webkit-tap-highlight-color: transparent;\n}\n.restaurant-scene .scene-target span,\n.restaurant-scene .scene-kitchen {\n  text-shadow: 0 1px 0 #fbf7ef;\n}\n.restaurant-scene .scene-target:hover,\n.restaurant-scene .scene-target:focus-visible,\n.restaurant-scene .scene-target[aria-pressed=\"true\"] {\n  background: var(--surface-card, #fbf7ef);\n  box-shadow: 0 0 0 1px var(--hairline-strong, #241d163d), var(--shadow-chip, 0 1px 2px #241d161f);\n}\n.restaurant-scene .scene-target:focus-visible {\n  outline: 2px solid var(--text-secondary, #5e554a);\n  outline-offset: 3px;\n}\n.restaurant-scene .scene-table i {\n  width: 4px;\n  height: 4px;\n  border: 1px solid currentColor;\n  border-radius: 50%;\n}\n.restaurant-scene .scene-table[data-phase=\"ordered\"] i,\n.restaurant-scene .scene-table[data-phase=\"checkout\"] i { background: currentColor; }\n.restaurant-scene .scene-table[data-phase=\"served\"] i,\n.restaurant-scene .scene-table[data-phase=\"empty\"] i { visibility: hidden; }\n"],["STYLE",{},".topbar nav:has(> .ambience-settings) { position: relative; }\n.ambience-settings { color: var(--text-secondary); }\n.ambience-settings summary {\n  display: flex; align-items: center; justify-content: center; gap: var(--space-8);\n  min-width: 44px; min-height: 44px; padding: 0 var(--space-8); cursor: pointer;\n  list-style: none; border-radius: var(--radius-chip);\n}\n.ambience-settings summary::-webkit-details-marker { display: none; }\n.ambience-settings summary:focus-visible { outline: 2px solid var(--text-primary); outline-offset: 2px; }\n.ambience-settings[open] summary { background: var(--surface-control); }\n.ambience-options {\n  position: absolute; right: 0; top: 100%; z-index: 20; width: min(250px, 80vw);\n  padding: var(--space-16); background: var(--surface-card); border: 1px solid var(--hairline);\n  border-radius: var(--radius-panel); box-shadow: var(--shadow-panel);\n}\n.ambience-options label { display: flex; align-items: center; gap: var(--space-8); min-height: 44px; }\n.ambience-options input { min-height: 44px; accent-color: var(--text-primary); }\n.ambience-options input[type=\"checkbox\"] { width: 20px; height: 20px; min-width: 20px; min-height: 20px; margin: 0; }\n.ambience-level-label { flex-shrink: 0; white-space: nowrap; }\n.ambience-options input[type=\"range\"] { flex: 1; min-width: 44px; width: 0; }\n.ambience-options p { margin: var(--space-8) 0; }\n.ambience-options button { min-height: 44px; }\n@media (max-width: 600px) { .ambience-label { display: none; } }\n"],["STYLE",{},"/* 君言 Junyan design tokens, 晨雾 Morning Steam, v0.1.0.\n   Generated from docs/design/tokens.json; edit the JSON, not this file.\n   Theme: data-theme=\"morning\" (default) | \"evening\" on the root element. */\n\n:root,\n[data-theme=\"morning\"] {\n  /* Colour */\n  --surface-card: #fbf7ef;\n  --surface-raised: #f4eee4;\n  --surface-control: #f1eadd;\n  --surface-sunk: #e8dfcf;\n  --hairline: #241d161a;\n  --hairline-strong: #241d163d;\n  --slot-edge: #241d1673;\n  --text-primary: #241d16;\n  --text-secondary: #5e554a;\n  --text-muted: #7b7266;\n  --accent: #b5462b;\n  --accent-ink: #9c3a22;\n  --word-marker: #b5462b;\n  --chop: #b5462b;\n  --jade: #6f9a86;\n  --steam: #fffaf0;\n  --window-cool: #9eafbc;\n  --lamp-glow: #ffd492;\n\n  /* Type families */\n  --font-sans: \"Noto Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif;\n  --font-serif: \"Noto Serif SC\", \"Songti SC\", serif;\n\n  /* Type styles: Interface (sans) */\n  --caption-font-size: 12px;\n  --caption-line-height: 16px;\n  --caption-font-weight: 500;\n  --label-font-size: 14px;\n  --label-line-height: 20px;\n  --label-font-weight: 500;\n  --body-font-size: 16px;\n  --body-line-height: 24px;\n  --body-font-weight: 400;\n  --title-font-size: 20px;\n  --title-line-height: 28px;\n  --title-font-weight: 500;\n\n  /* Type styles: Spoken (serif) */\n  --spoken-font-size: 40px;\n  --spoken-line-height: 60px;\n  --spoken-font-weight: 500;\n  --spoken-compact-font-size: 32px;\n  --spoken-compact-line-height: 44px;\n  --spoken-compact-font-weight: 500;\n  --board-font-size: 20px;\n  --board-line-height: 32px;\n  --board-font-weight: 500;\n  --seal-font-size: 20px;\n  --seal-line-height: 20px;\n  --seal-font-weight: 600;\n\n  /* Spacing */\n  --space-4: 4px;\n  --space-8: 8px;\n  --space-12: 12px;\n  --space-16: 16px;\n  --space-24: 24px;\n  --space-32: 32px;\n  --space-48: 48px;\n\n  /* Radius */\n  --radius-panel: 16px;\n  --radius-chip: 10px;\n  --radius-tile: 8px;\n  --radius-receipt: 4px;\n\n  /* Shadow */\n  --shadow-panel: 0 8px 24px rgba(36,29,22,.18);\n  --shadow-chip: 0 1px 2px rgba(36,29,22,.12);\n\n  /* Motion (from design-system.md; not in tokens.json) */\n  --ease: cubic-bezier(0.22, 1, 0.36, 1);\n  --duration-press: 120ms;\n  --duration-move: 200ms;\n  --duration-arrive: 320ms;\n}\n\n[data-theme=\"evening\"] {\n  --surface-card: #2b221a;\n  --surface-raised: #342920;\n  --surface-control: #3a2e24;\n  --surface-sunk: #1f1913;\n  --hairline: #f4ead81f;\n  --hairline-strong: #f4ead83d;\n  --slot-edge: #f4ead873;\n  --text-primary: #f4ead8;\n  --text-secondary: #cbbda7;\n  --text-muted: #9a8d7b;\n  --accent: #dd6f4f;\n  --accent-ink: #ec9475;\n  --word-marker: #e57a55;\n  --chop: #dd6f4f;\n  --jade: #5b8573;\n  --steam: #f6dcb4;\n  --window-cool: #4a5878;\n  --lamp-glow: #ffb86a;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  :root {\n    --duration-move: 120ms;\n    --duration-arrive: 120ms;\n  }\n}\n"],["STYLE",{},"* {\n  box-sizing: border-box;\n}\nbody {\n  margin: 0;\n  background: var(--surface-card);\n  color: var(--text-primary);\n  font-family: var(--font-sans);\n  font-size: 16px;\n  line-height: 1.5;\n  font-variant-numeric: tabular-nums;\n}\nbutton,\na {\n  -webkit-tap-highlight-color: transparent;\n}\nbutton {\n  font: inherit;\n  color: inherit;\n  cursor: pointer;\n  min-height: 44px;\n  border: 0;\n  background: none;\n}\nbutton:disabled {\n  cursor: default;\n  opacity: 0.45;\n}\nbutton:focus-visible,\na:focus-visible {\n  outline: 2px solid var(--text-secondary);\n  outline-offset: 4px;\n}\nbutton:hover:not(:disabled) {\n  background-color: var(--surface-sunk);\n}\nsvg {\n  width: 22px;\n  height: 22px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.6;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\na {\n  color: inherit;\n  text-decoration: none;\n}\n.app-shell {\n  max-width: 1040px;\n  margin: auto;\n  padding: 0 var(--space-24) var(--space-24);\n}\n.topbar {\n  min-height: 76px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-16);\n}\n.brand {\n  display: flex;\n  align-items: center;\n  gap: var(--space-12);\n  min-height: 44px;\n  font-size: var(--label-font-size);\n  letter-spacing: 0.08em;\n}\n.brand-seal {\n  font-family: var(--font-serif);\n  line-height: 1.2;\n  border: 1px solid var(--hairline-strong);\n  padding: var(--space-4);\n  border-radius: var(--radius-receipt);\n}\n.brand-divider {\n  padding: 0 var(--space-8);\n  color: var(--text-secondary);\n}\nnav {\n  display: flex;\n  gap: var(--space-8);\n  align-items: center;\n}\nnav button {\n  display: flex;\n  gap: var(--space-8);\n  align-items: center;\n  border-radius: var(--radius-tile);\n  padding: var(--space-8) var(--space-12);\n  font-size: var(--label-font-size);\n}\nnav small { color: var(--text-secondary); }\n.eyebrow {\n  font-size: 13px;\n  letter-spacing: 0.12em;\n  color: var(--text-secondary);\n  margin: 0 0 var(--space-12);\n}\nh2 {\n  font-family: var(--font-serif);\n  font-weight: 500;\n  margin: 0;\n  font-size: 26px;\n  line-height: 1.6;\n}\n.play-layout { display: grid; gap: var(--space-12); }\n.world-panel {\n  min-width: 0;\n  background: var(--surface-sunk);\n  border: 1px solid var(--hairline);\n  border-radius: var(--radius-panel);\n  overflow: hidden;\n}\n.world-caption {\n  background: var(--surface-raised);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-12);\n  padding: var(--space-4) var(--space-16);\n  color: var(--text-secondary);\n  font-size: var(--label-font-size);\n}\n.day-toggle {\n  display: flex;\n  gap: var(--space-8);\n  align-items: center;\n  border-radius: var(--radius-tile);\n  padding: 0 var(--space-8);\n}\n.day-progress { white-space: nowrap; }\n.day-toggle:focus-visible { outline-offset: -2px; }\n.day-details {\n  background: var(--surface-raised);\n  padding: var(--space-8) var(--space-24) var(--space-16);\n  font-size: var(--label-font-size);\n  color: var(--text-secondary);\n}\n.day-details span + span { margin-left: var(--space-24); }\n.world-panel .restaurant-scene {\n  width: min(100%, max(560px, calc((100svh - 380px) * 9 / 7)));\n  margin: auto;\n  border-radius: 0;\n  box-shadow: none;\n  background: var(--surface-raised);\n}\n.world-footer {\n  background: var(--surface-raised);\n  display: flex;\n  gap: var(--space-16);\n  align-items: center;\n  justify-content: flex-end;\n  padding: var(--space-8) var(--space-16);\n  border-top: 1px solid var(--hairline);\n}\n.next-hint {\n  margin-right: auto;\n  color: var(--text-secondary);\n  font-size: var(--label-font-size);\n}\n.next-hint:empty { display: none; }\n.world-footer .next-action {\n  width: auto;\n  margin: 0;\n  flex-shrink: 0;\n}\n.customer-list {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: var(--space-8);\n}\n.customer-row {\n  display: flex;\n  align-items: center;\n  text-align: left;\n  gap: var(--space-12);\n  padding: var(--space-8) var(--space-12);\n  border-radius: var(--radius-chip);\n}\n.table-number { font-size: var(--label-font-size); white-space: nowrap; }\n.customer-info { display: grid; gap: 0; }\n.customer-info b { font-size: var(--label-font-size); font-weight: 500; }\n.customer-info small { color: var(--text-secondary); font-size: 12px; }\n.customer-done .customer-info { opacity: 0.65; }\n.tray-section {\n  display: flex;\n  align-items: center;\n  gap: var(--space-16);\n  min-height: 68px;\n  margin-top: var(--space-8);\n  padding: var(--space-8) var(--space-12);\n  border-top: 1px solid var(--hairline);\n}\n.section-label {\n  display: grid;\n  flex-shrink: 0;\n  font-size: var(--label-font-size);\n}\n.section-label span + span { color: var(--text-secondary); font-size: 12px; }\n.tray {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: var(--space-4);\n  flex: 1;\n  min-width: 0;\n}\n.tray-item {\n  display: flex;\n  align-items: center;\n  gap: var(--space-4);\n  font-size: var(--label-font-size);\n  border-radius: var(--radius-tile);\n  padding: var(--space-4) var(--space-8);\n  background: var(--surface-raised);\n}\n.food-art {\n  display: block;\n  width: 64px;\n  height: 48px;\n  stroke: none;\n  margin: auto;\n}\n.tray-item .food-art { width: 36px; height: 32px; }\n.kitchen-link {\n  display: flex;\n  align-items: center;\n  gap: var(--space-8);\n  flex-shrink: 0;\n  padding: var(--space-8);\n  border-radius: var(--radius-tile);\n  font-size: var(--label-font-size);\n}\n.help-disclosure {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: var(--space-12);\n  border-radius: var(--radius-tile);\n  padding: var(--space-8) var(--space-12);\n  font-size: var(--label-font-size);\n  color: var(--text-secondary);\n}\n.help-disclosure[aria-expanded=\"true\"] { border-bottom: 1px solid var(--hairline); }\n.modal-backdrop {\n  position: fixed;\n  inset: 0;\n  background: #241d164f;\n  backdrop-filter: blur(3px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 10;\n  padding: 24px;\n  overflow-y: auto;\n}\n.paper-panel {\n  position: relative;\n  width: min(100%, 570px);\n  background: var(--surface-card);\n  border-radius: var(--radius-panel);\n  border: 1px solid var(--hairline);\n  box-shadow: var(--shadow-panel);\n  padding: 36px;\n  max-height: 90dvh;\n  overflow-y: auto;\n}\n.close-button {\n  position: absolute;\n  right: 11px;\n  top: 10px;\n  font-family: system-ui;\n  font-size: 26px;\n  font-weight: 300;\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  padding: 0;\n  color: var(--text-secondary);\n}\n.primary,\n.secondary {\n  padding: 13px 20px;\n  min-height: 48px;\n  border-radius: var(--radius-tile);\n  font-size: 14px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n}\n.primary {\n  background: var(--text-primary);\n  color: var(--surface-card);\n  width: 100%;\n  margin-top: 24px;\n}\n.primary:hover:not(:disabled) {\n  background: var(--text-secondary);\n}\n.secondary {\n  border: 1px solid var(--hairline-strong);\n  margin-top: 24px;\n}\n.primary span {\n  font-size: 20px;\n  line-height: 1;\n}\n.help-steps {\n  margin: 26px 0;\n}\n.help-steps p {\n  display: flex;\n  gap: 20px;\n  font-size: 16px;\n  margin: 20px 0;\n}\n.help-steps b {\n  font-family: var(--font-serif);\n  font-weight: 400;\n  background: var(--surface-sunk);\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n  flex-shrink: 0;\n}\n.help-steps small {\n  display: block;\n  color: var(--text-secondary);\n  font-size: 12px;\n  margin-top: 6px;\n}\n.help-foot {\n  text-align: center;\n  color: var(--text-secondary);\n  font-size: 12px;\n  margin: 16px 0 0;\n}\n.learning-help {\n  padding-top: 24px;\n}\n.learning-help .help-line {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.learning-help .spoken {\n  flex: 1;\n  min-width: 0;\n  font-size: 28px;\n  margin: 8px 0;\n}\n.learning-help .round-button {\n  flex-shrink: 0;\n}\n.learning-help-steps {\n  list-style: none;\n  padding: 0;\n  margin: 16px 0;\n}\n.learning-help-steps li {\n  position: relative;\n  padding: 12px 0;\n  border-top: 1px solid var(--hairline);\n}\n.learning-help .help-step-number {\n  position: absolute;\n  top: 16px;\n  left: 0;\n  font-family: var(--font-serif);\n}\n.learning-help .help-picture {\n  display: block;\n  width: min(100%, 280px);\n  height: 64px;\n  margin: auto;\n  color: var(--text-secondary);\n}\n.dialogue-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding-right: 30px;\n  color: var(--text-secondary);\n  font-size: 14px;\n  margin-bottom: 22px;\n}\n.round-button {\n  width: 44px;\n  height: 44px;\n  background: var(--surface-control);\n  border: 1px solid var(--hairline);\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n}\n.spoken {\n  font-size: 32px;\n  font-family: var(--font-serif);\n  line-height: 1.8;\n  margin: 12px 0 20px;\n}\n.word {\n  position: relative;\n  font: inherit;\n  padding: 0 3px;\n  margin: 0 3px 5px 0;\n  min-width: 44px;\n  min-height: 48px;\n  border-bottom: 2px solid var(--hairline);\n  border-radius: 4px 4px 0 0;\n}\n.new-word:before {\n  content: \"\";\n  position: absolute;\n  width: 5px;\n  height: 5px;\n  border-radius: 50%;\n  background: var(--word-marker);\n  left: calc(50% - 2px);\n  top: -4px;\n}\n.subtle {\n  font-size: 13px;\n  color: var(--text-secondary);\n  margin: 15px 0;\n}\n.dialogue-actions {\n  display: flex;\n  gap: 12px;\n}\n.dialogue-actions .primary {\n  flex: 1;\n}\n.dialogue-actions .secondary {\n  flex: 1;\n}\n.kitchen-panel {\n  width: 680px;\n}\n.food-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 12px;\n  margin: 26px 0;\n}\n.food-choice {\n  position: relative;\n  background: var(--surface-raised);\n  border-radius: var(--radius-tile);\n  padding-bottom: 2px;\n}\n.food-pick {\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  padding: 13px 5px 5px;\n  position: relative;\n  border-radius: var(--radius-tile);\n}\n.food-pick > span {\n  font-family: var(--font-serif);\n  font-size: 20px;\n  margin-top: 6px;\n}\n.food-pick > small {\n  font-size: 11px;\n  color: var(--text-secondary);\n  margin-top: 3px;\n}\n.food-pick > i {\n  font-style: normal;\n  position: absolute;\n  right: 7px;\n  top: 2px;\n  font-size: 20px;\n  color: var(--text-secondary);\n}\n.food-listen {\n  height: 44px;\n  width: 100%;\n  display: grid;\n  place-items: center;\n}\n.food-listen svg {\n  width: 17px;\n  height: 17px;\n}\n.kitchen-tray {\n  border-top: 1px solid var(--hairline-strong);\n  padding-top: 15px;\n  font-size: 12px;\n  min-height: 86px;\n}\n.kitchen-tray > div {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-top: 9px;\n}\n.kitchen-tray button {\n  background: var(--surface-sunk);\n  border-radius: 6px;\n  font-size: 14px;\n  padding: 5px 12px;\n}\n.kitchen-tray button span {\n  padding-left: 8px;\n  color: var(--text-secondary);\n}\n.word-popover {\n  position: fixed;\n  right: max(24px, calc((100vw - 1300px) / 2));\n  bottom: 24px;\n  width: 280px;\n  padding: 28px;\n  background: var(--surface-card);\n  box-shadow: var(--shadow-panel);\n  border: 1px solid var(--hairline-strong);\n  border-radius: var(--radius-panel);\n  z-index: 20;\n}\n.word-card-title {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: 12px;\n}\n.word-card-title h2 {\n  font-size: 36px;\n  color: var(--accent-ink);\n}\n.word-popover .food-art {\n  width: 96px;\n  height: 72px;\n  margin-top: 12px;\n}\n.pinyin {\n  font-size: 18px;\n  margin: 10px 0 6px;\n}\n.gloss {\n  font-size: 14px;\n  color: var(--text-secondary);\n  margin: 0;\n}\n.journal-list {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n  margin-top: 24px;\n}\n.journal-list button {\n  text-align: left;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  background: var(--surface-raised);\n  padding: 12px;\n  border-radius: 8px;\n}\n.journal-list span {\n  font-family: var(--font-serif);\n  font-size: 22px;\n}\n.journal-list small {\n  font-size: 10px;\n  color: var(--text-secondary);\n  margin-left: auto;\n}\n.journal-list svg {\n  width: 16px;\n  flex-shrink: 0;\n}\n.journal-empty {\n  padding: 40px 0;\n  color: var(--text-secondary);\n  font-size: 14px;\n}\n.checkout-title {\n  font-family: var(--font-serif);\n  font-size: 28px;\n  line-height: 1.8;\n}\n.change-display {\n  font-size: 40px;\n  padding: 10px 0;\n  font-family: var(--font-serif);\n}\n.change-display span {\n  font-size: 18px;\n}\n.money-buttons {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.money-buttons button {\n  background: var(--surface-raised);\n  border: 1px solid var(--hairline);\n  padding: 10px 16px;\n  border-radius: 8px;\n}\n.gentle-feedback {\n  padding: 12px 16px;\n  background: var(--surface-sunk);\n  border-radius: 8px;\n  margin-top: 20px;\n  font-size: 14px;\n}\n.gentle-feedback .spoken {\n  font-size: 28px;\n}\n.gentle-feedback p {\n  font-size: 12px;\n}\n.receipt {\n  position: relative;\n  background: #fffdf7;\n  box-shadow: 0 2px 8px #241d1612;\n  padding: 28px 24px 45px;\n  margin: 24px auto;\n  width: 90%;\n  max-width: 330px;\n  border: 1px solid var(--hairline);\n  border-radius: var(--radius-receipt);\n}\n.receipt-title {\n  display: block;\n  text-align: center;\n  font-family: var(--font-serif);\n  font-size: 20px;\n  margin-bottom: 20px;\n  letter-spacing: 0.16em;\n}\n.receipt p {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  font-size: 14px;\n  margin: 0;\n}\n.receipt p > span:last-child {\n  margin-left: auto;\n}\n.receipt button {\n  padding: 0;\n  min-width: 44px;\n  min-height: 44px;\n  font-family: var(--font-serif);\n  font-size: 18px;\n}\n.receipt-total {\n  border-top: 1px dashed var(--hairline-strong);\n  padding-top: 16px;\n  margin-top: 12px !important;\n}\n.receipt-total b {\n  font-weight: 500;\n}\n.receipt-total span {\n  font-size: 12px;\n}\n.thanks-chop {\n  position: absolute;\n  bottom: 12px;\n  right: 24px;\n  border: 2px solid var(--chop);\n  color: var(--chop);\n  font-family: var(--font-serif);\n  font-size: 20px;\n  line-height: 1;\n  padding: 5px;\n  transform: rotate(-8deg);\n}\n.tally {\n  padding: 24px 0;\n  margin-top: 18px;\n  border-top: 1px solid var(--hairline);\n  border-bottom: 1px solid var(--hairline);\n}\n.tally p {\n  display: flex;\n  justify-content: space-between;\n  margin: 12px 0;\n  font-size: 15px;\n}\n.tally b {\n  font-weight: 500;\n}\n.save-note {\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n.loading {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  font-family: var(--font-serif);\n  font-size: 24px;\n}\n@media (max-width: 760px) {\n  .app-shell { padding: 0 var(--space-1
{"type":"before","callId":"jbxa@2008","startTime":96877.344,"class":"Frame","method":"evaluateExpression","params":{"expression":"async ({\n      save,\n      target\n    }) => {\n      const {\n        mapsForNeighbourhood\n      } = await import('/src/world/dynamic.ts');\n      const {\n        restoreWorld\n      } = await import('/src/world/state.ts');\n      const {\n        findPath\n      } = await import('/src/world/geometry.ts');\n      const {\n        cameraForMap,\n        project\n      } = await import('/src/world/camera.ts');\n      const maps = mapsForNeighbourhood(save.neighbourhood),\n        world = restoreWorld(save.world, maps, save.neighbourhood.location),\n        map = maps[world.mapId];\n      const distance = Math.hypot(world.position.x - target.x, world.position.y - target.y);\n      if (distance < .19) return {\n        done: true\n      };\n      const path = findPath(map, world.position, target);\n      if (!path.length) return {\n        error: `No path ${map.id} ${JSON.stringify(world.position)} to ${JSON.stringify(target)}`\n      };\n      const next = path[0],\n        dx = next.x - world.position.x,\n        dy = next.y - world.position.y,\n        length = Math.hypot(dx, dy),\n        amount = Math.min(1, 2.5 / length),\n        point = {\n          x: world.position.x + dx * amount,\n          y: world.position.y + dy * amount\n        };\n      const canvas = document.querySelector('.connected-world canvas'),\n        rect = canvas.getBoundingClientRect(),\n        camera = cameraForMap(map.bounds, world.position, canvas.width, canvas.height, rect.width < 600 ? 11 : 15),\n        pixel = project(point, camera);\n      return {\n        point,\n        x: rect.left + pixel.x / canvas.width * rect.width,\n        y: rect.top + pixel.y / canvas.height * rect.height,\n        mapId: map.id\n      };\n    }","isFunction":true,"arg":{"value":{"o":[{"k":"save","v":{"o":[{"k":"seed","v":{"n":955863294}},{"k":"day","v":{"n":1}},{"k":"le
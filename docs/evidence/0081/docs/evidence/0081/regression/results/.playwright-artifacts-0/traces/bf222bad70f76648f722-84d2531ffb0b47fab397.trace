{"type":"before","callId":"jbxa@753","startTime":34460.201,"class":"Frame","method":"evaluateExpression","params":{"expression":"async ({\n      save,\n      target\n    }) => {\n      const {\n        mapsForNeighbourhood\n      } = await import('/src/world/dynamic.ts');\n      const {\n        restoreWorld\n      } = await import('/src/world/state.ts');\n      const {\n        findPath\n      } = await import('/src/world/geometry.ts');\n      const {\n        cameraForMap,\n        project\n      } = await import('/src/world/camera.ts');\n      const maps = mapsForNeighbourhood(save.neighbourhood),\n        world = restoreWorld(save.world, maps, save.neighbourhood.location),\n        map = maps[world.mapId];\n      const distance = Math.hypot(world.position.x - target.x, world.position.y - target.y);\n      if (distance < .19) return {\n        done: true\n      };\n      const path = findPath(map, world.position, target);\n      if (!path.length) return {\n        error: `No path ${map.id} ${JSON.stringify(world.position)} to ${JSON.stringify(target)}`\n      };\n      const next = path[0],\n        dx = next.x - world.position.x,\n        dy = next.y - world.position.y,\n        length = Math.hypot(dx, dy),\n        amount = Math.min(1, 2.5 / length),\n        point = {\n          x: world.position.x + dx * amount,\n          y: world.position.y + dy * amount\n        };\n      const canvas = document.querySelector('.connected-world canvas'),\n        rect = canvas.getBoundingClientRect(),\n        camera = cameraForMap(map.bounds, world.position, canvas.width, canvas.height, rect.width < 600 ? 11 : 15),\n        pixel = project(point, camera);\n      return {\n        point,\n        x: rect.left + pixel.x / canvas.width * rect.width,\n        y: rect.top + pixel.y / canvas.height * rect.height,\n        mapId: map.id\n      };\n    }","isFunction":true,"arg":{"value":{"o":[{"k":"save","v":{"o":[{"k":"seed","v":{"n":955863294}},{"k":"day","v":{"n":1}},{"k":"level","v":{"n":1}},{"k":"player","v":{"o":[{"k":"x","v":{"n":10.4}},{"k":"y","v":{"n":4}}],"id":3}},{"k":"customers","v":{"a":[{"o":[{"k":"table","v":{"n":1}},{"k":"orderId","v":{"s":"order-01"}},{"k":"phase","v":{"s":"served"}}],"id":5},{"o":[{"k":"table","v":{"n":2}},{"k":"orderId","v":{"s":"order-02"}},{"k":"phase","v":{"s":"served"}}],"id":6},{"o":[{"k":"table","v":{"n":3}},{"k":"orderId","v":{"s":"order-03"}},{"k":"phase","v":{"s":"seated"}}],"id":7},{"o":[{"k":"table","v":{"n":4}},{"k":"orderId","v":{"s":"order-04"}},{"k":"phase","v":{"s":"seated"}}],"id":8}],"id":4}},{"k":"tray","v":{"a":[],"id":9}},{"k":"served","v":{"n":2}},{"k":"earnings","v":{"n":5}},{"k":"mistakes","v":{"n":0}},{"k":"activeTable","v":{"n":2}},{"k":"feedback","v":{"s":"thanks"}},{"k":"receipt","v":{"o":[{"k":"table","v":{"n":2}},{"k":"total","v":{"n":3}},{"k":"change","v":{"n":2}}],"id":10}},{"k":"journal","v":{"o":[{"k":"milk","v":{"o":[{"k":"lookups","v":{"n":0}},{"k":"lastSeen","v":{"n":1793925212872}},{"k":"recovered","v":{"b":true}}],"id":12}},{"k":"egg","v":{"o":[{"k":"lookups","v":{"n":0}},{"k":"lastSeen","v":{"n":1793925212872}},{"k":"recovered","v":{"b":true}}],"id":13}},{"k":"thank-you","v":{"o":[{"k":"lookups","v":{"n":0}},{"k":"lastSeen","v":{"n":1793925212872}},{"k":"recovered","v":{"b":true}}],"id":14}},{"k":"good","v":{"o":[{"k":"lookups","v":{"n":0}},{"k":"lastSeen","v":{"n":1793925212872}},{"k":"recovered","v":{"b":true}}],"id":15}},{"k":"good-morning","v":{"o":[{"k":"lookups","v":{"n":1}},{"k":"lastSeen","v":{"n":1793925217129}},{"k":"recovered","v":{"b":false}}],"id":16}},{"k":"i","v":{"o":[{"k":"lookups","v":{"n":0}},{"k":"lastSeen","v":{"n":1793925223165}},{"k":"recovered","v":{"b":true}}],"id":17}},{"k":"think","v":{"o":[{"k":"lookups","v":{"n":0}},{"k":"lastSeen","v":{"n":1793925223165}},{"k":"recovered","v":{"b":true}}],"id":18}},{"k":"want","v":{"o":[{"k":"lookups","v":{"n":0}},{"k":"lastSeen","v":{"n":1793925223165}},{"k":"recovered","v":{"b":true}}],"id":19}},{"k"